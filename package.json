{
  "name": "ragsystem-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "backend-ts",
    "frontend-client"
  ],
  "scripts": {
    "build:protocol": "npm -w @ragsystem/agent-protocol run build",
    "typecheck:protocol": "npm -w @ragsystem/agent-protocol run typecheck",
    "typecheck:backend": "npm -w @ragsystem/backend-ts run typecheck",
    "build:frontend": "npm -w frontend-client run build",
    "demo": "npm -w @ragsystem/demo-app run start"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "shadcn-vue": "^2.7.4"
  }
}
