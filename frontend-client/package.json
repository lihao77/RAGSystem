{
  "name": "frontend-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json",
    "test": "node --require ./test-setup.cjs --test src/api/*.test.js src/utils/*.test.js src/composables/*.test.js src/components/*.test.js src/stores/*.test.js",
    "test:coverage": "node --require ./test-setup.cjs --experimental-test-coverage --test-coverage-include=src/**/*.js --test-coverage-exclude=src/**/*.test.js --test-coverage-lines=65 --test-coverage-branches=60 --test-coverage-functions=50 --test src/api/*.test.js src/utils/*.test.js src/composables/*.test.js src/components/*.test.js src/stores/*.test.js",
    "check": "npm run lint && npm run typecheck && npm run typecheck:core && npm run test:coverage && npm run build && npm run check:bundle-size",
    "screenshot:smoke": "node scripts/screenshot-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@ragsystem/agent-protocol": "*",
    "@ragsystem/api-contracts": "*",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "github-markdown-css": "^5.8.1",
    "highlight.js": "^11.11.1",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "less": "^4.5.1",
    "less-loader": "^12.3.0",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4",
    "vue-virtual-scroller": "^2.0.0-beta.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.2",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.5.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.7"
  }
}
