{
  "name": "@ragsystem/backend-plugin-execution-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@ragsystem/agent-sdk": "*",
    "@vscode/ripgrep": "^1.18.0",
    "ipaddr.js": "^2.5.0",
    "turndown": "^7.2.4",
    "undici": "^7.29.1",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@ragsystem/backend-core": "0.1.x"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.6.0"
  }
}
