{
  "name": "@ragsystem/backend-plugin-knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@ragsystem/agent-llm": "*",
    "@ragsystem/agent-sdk": "*",
    "mammoth": "^1.12.0",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@ragsystem/backend-core": "0.1.x",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9"
  }
}
