{
  "name": "ragsystem-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "npm run build:frontend && npm run build:backend && electron .",
    "dev:fast": "node scripts/dev-fast.mjs",
    "build:frontend": "npm --prefix .. run build:frontend",
    "build:backend": "npm --prefix .. run build:backend-local-deps && node scripts/prepare-backend.mjs && node scripts/probe-backend.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:packaged": "node scripts/smoke-desktop.mjs --packaged",
    "test:attachments": "node scripts/probe-file-path.cjs",
    "build:installer": "npm run build:frontend && npm run build:backend && electron-builder --win nsis",
    "pack": "npm run build:frontend && npm run build:backend && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "26.0.12",
    "esbuild": "^0.27.2"
  },
  "build": {
    "appId": "com.ragsystem.desktop",
    "productName": "RAGSystem",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico",
      "build/icon.svg"
    ],
    "extraResources": [
      {
        "from": "dist/backend-local",
        "to": "backend-local",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../frontend-client/dist",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.27.2": true
  }
}
