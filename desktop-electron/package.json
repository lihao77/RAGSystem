{
  "name": "ragsystem-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "npm run build:frontend && npm run build:backend && electron .",
    "build:frontend": "npm --prefix .. -w frontend-client run build",
    "build:backend": "npm --prefix .. -w @ragsystem/backend-core run build && npm --prefix .. -w @ragsystem/backend-plugin-artifacts run build && node scripts/prepare-backend.mjs && node scripts/probe-backend.mjs",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "build:installer": "npm run build:frontend && npm run build:backend && electron-builder --win nsis",
    "pack": "npm run build:frontend && npm run build:backend && electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.27.2"
  },
  "build": {
    "appId": "com.ragsystem.desktop",
    "productName": "RAGSystem",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.ico",
      "build/icon.svg"
    ],
    "extraResources": [
      {
        "from": "dist/backend-local",
        "to": "backend-local",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      {
        "from": "dist/backend-local/node_modules/sqlite-vec",
        "to": "backend-local/node_modules/sqlite-vec"
      },
      {
        "from": "dist/backend-local/node_modules/sqlite-vec-windows-x64",
        "to": "backend-local/node_modules/sqlite-vec-windows-x64"
      },
      {
        "from": "../frontend-client/dist",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  }
}
