{
  "name": "@ragsystem/backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "smoke:outbox-live": "tsx scripts/outbox-live-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.0.0",
    "@larksuiteoapi/node-sdk": "^1.71.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@ragsystem/agent-llm": "*",
    "@ragsystem/agent-protocol": "*",
    "@ragsystem/agent-sdk": "*",
    "@ragsystem/api-contracts": "*",
    "@types/turndown": "^5.0.6",
    "diff": "^8.0.4",
    "fastify": "^5.0.0",
    "mammoth": "^1.12.0",
    "pg": "^8.22.0",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "unpdf": "^1.6.2",
    "yaml": "^2.9.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "sqlite-vec-linux-arm64": "0.1.9",
    "sqlite-vec-linux-x64": "0.1.9"
  }
}
