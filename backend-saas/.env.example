BACKEND_TS_HOST=0.0.0.0
BACKEND_TS_PORT=5002
BACKEND_TS_LOG_LEVEL=info
# Prefer an absolute path in production and mount the YAML read-only.
# BACKEND_PLUGIN_CONFIG=/etc/ragsystem/backend.plugins.yaml
DEPLOYMENT_MODE=saas
AUTH_MODE=password
TENANCY_MODE=multi
EXECUTION_MODE=remote
STORAGE_MODE=postgres
CONTROL_STORAGE_MODE=postgres
UI_MODE=saas
DATABASE_URL=postgres://ragsystem:ragsystem@localhost:5432/ragsystem
CONTROL_DATABASE_URL=postgres://ragsystem:ragsystem@localhost:5432/ragsystem
# Base64-encoded 32-byte key.
CONTROL_SECRET_MASTER_KEY=
# Use at least 32 random characters.
SESSION_JWT_SECRET=
SESSION_TOKEN_TTL_HOURS=168
OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_BUCKET=ragsystem
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
SANDBOX_REMOTE_URL=
SANDBOX_REMOTE_TOKEN=
SANDBOX_REQUEST_TIMEOUT_MS=30000
SANDBOX_LEASE_TIMEOUT_SECONDS=900
SANDBOX_ALLOW_INSECURE_HTTP=false
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
