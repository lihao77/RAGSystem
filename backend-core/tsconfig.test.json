{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "noEmit": true,
    "types": ["node", "vitest"],
    "baseUrl": ".",
    "paths": {
      "@ragsystem/backend-core/*": ["src/*"],
      "@ragsystem/backend-plugin-artifacts/*": ["../plugins/backend-plugin-artifacts/src/*"],
      "@ragsystem/backend-local/*": ["../backend-local/src/*"],
      "@ragsystem/backend-saas/*": ["../backend-saas/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
