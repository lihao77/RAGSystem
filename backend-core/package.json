{
  "name": "@ragsystem/backend-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "smoke:outbox-live": "tsx scripts/outbox-live-smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.0.0",
    "@larksuiteoapi/node-sdk": "^1.71.0",
    "@ragsystem/agent-llm": "*",
    "@ragsystem/agent-protocol": "*",
    "@ragsystem/agent-sdk": "*",
    "@ragsystem/api-contracts": "*",
    "diff": "^8.0.4",
    "fastify": "^5.0.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
